    string entryText = na(lastEntry) ? "N/A" : (lastDirection == 1 ? "BUY " : "SELL ") + str.tostring(lastEntry, format.mintick)
    string slText = na(lastSL) ? "N/A" : str.tostring(lastSL, format.mintick)
    string tpText = na(lastTP) ? "N/A" : str.tostring(lastTP, format.mintick)

    array<string> titles = array.from("ALPHA MTF", "TRANG THAI", "ENTRY GAN NHAT", "SL", "TP H4 1.618", "CHU KY")
    array<string> values = array.from(view, lastStatus, entryText, slText, tpText, lastOutcome)

    for row = 0 to 5
        table.cell(panel, 0, row, array.get(titles, row), text_color=color.silver, text_size=size.small)
